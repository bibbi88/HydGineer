{
  "name": "hydgineer-desktop",
  "productName": "HydGineer",
  "version": "0.1.0",
  "description": "Hydraulic circuit editor and simulator",
  "author": "bibbi88",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:flatpak": "electron-builder --linux flatpak --publish never",
    "dist:appimage": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.bibbi88.HydGineer",
    "productName": "HydGineer",
    "copyright": "bibbi88",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "hgcl",
        "name": "HydGineer project",
        "description": "HydGineer project",
        "mimeType": "application/x-hydgineer"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "HydGineer-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HydGineer"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "Hydraulic circuit editor and simulator",
      "description": "Draw hydraulic and electro-hydraulic circuits with ISO 1219 symbols and simulate their pressures and flows.",
      "artifactName": "HydGineer.${ext}"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/bibbi88/HydGineer/releases/latest/download",
        "channel": "latest"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
